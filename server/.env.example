# Copy to server/.env and fill in real values. Never commit .env.
NODE_ENV=production
PORT=5001

# Comma-separated list of origins allowed to call the API (your live site, plus www if used).
SITE_ORIGIN=https://www.striveraglobal.co.uk,https://striveraglobal.co.uk

# Number of proxies in front of the app (1 when behind Nginx).
TRUST_PROXY=1

# Max form submissions per IP per 15 minutes.
RATE_LIMIT_MAX=5

# SMTP credentials from your email provider (e.g. Microsoft 365, Google Workspace, Amazon SES).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Sender shown on emails (must be allowed by your SMTP provider) and the inbox that receives enquiries.
MAIL_FROM="Strivera Global <info@striveraglobal.co.uk>"
MAIL_TO=info@striveraglobal.co.uk
